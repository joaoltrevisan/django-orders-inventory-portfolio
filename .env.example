# Run python3 scripts/create_env.py to generate private local values.
DJANGO_SECRET_KEY=replace-with-a-generated-secret
POSTGRES_PASSWORD=replace-with-a-generated-bootstrap-password
MIGRATION_DB_PASSWORD=replace-with-a-generated-owner-password
IMPORT_DB_PASSWORD=replace-with-a-generated-importer-password
APP_DB_PASSWORD=replace-with-a-generated-api-password
TEST_DB_PASSWORD=replace-with-a-generated-test-password
PGDATABASE=olist_case_study
APP_PORT=18020
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional compose.worker.yaml: set these deliberately before enabling workers.
EXPIRY_EXPECTED_DATABASE=replace-with-the-intended-database
EXPIRY_ACTOR_EMAIL=replace-with-an-active-administrator@example.com
EXPIRY_INTERVAL_SECONDS=60
EXPIRY_BATCH_LIMIT=100
