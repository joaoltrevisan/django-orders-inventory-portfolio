  "sql": "-- Frozen experiment query: a delivered-order history page in a fixed source purchase interval.\nSELECT o.source_order_id,o.purchased_at_source,c.customer_unique_id\nFROM olist_order o INNER JOIN olist_customer c ON c.id=o.customer_id\nWHERE o.source_status='delivered'\nAND o.snapshot_id=(SELECT id FROM olist_dataset_snapshot WHERE publication_status='COMPLETE')\nAND o.purchased_at_source >= %(start)s::timestamp AND o.purchased_at_source < %(end)s::timestamp\nORDER BY o.purchased_at_source,o.source_order_id LIMIT %(row_limit)s;\n",
  "sql_sha256": "2cd76c1c2428bdd21baa2d17e28e53bc8c454ee13648d32ab19e9057dcd3581b",
  "parameters": {
    "start": "2017-11-01 00:00:00",
    "end": "2017-12-01 00:00:00",
    "row_limit": 100
  },
